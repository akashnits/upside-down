{
  "env": {
    "ANTHROPIC_API_KEY": ""
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "linear@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true
}
